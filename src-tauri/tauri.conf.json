    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4RjA4RTEzQjg0QkE1QzkKUldUSnBVdTRFNDd3V0xLUWxZOVczdVFHRlpqa3l1MEdEcDU0Q3VQVm1vU1hYempWYVZPczIySUwK",
