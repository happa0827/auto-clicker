{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "auto-clicker",
  "version": "0.1.0",
  "identifier": "com.heyyo.auto-clicker",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "auto-clicker",
        "width": 560,
        "height": 820,
        "minWidth": 380,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBOTQzMkI5NjJENzE0MTAKUldRUUZOZGl1VEtVbXBManlBT2s0TmpZQkExQm0zZUZLZ0phTUxIQXlRZHJXMkRDbXN0amtzVGgK",
      "endpoints": [
        "https://github.com/happa0827/auto-clicker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}