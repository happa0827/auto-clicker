  "productName": "auto-clicker",
  "version": "0.3.4",
  "identifier": "com.heyyo.auto-clicker",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "オートクリッカー",
        "width": 560,
        "height": 820,
        "minWidth": 380,
